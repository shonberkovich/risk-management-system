ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Deployment environment ---
# development (default) | staging | production. Setting this to "production" also flips the
# force_https default to true (see "Transport security" below) unless FORCE_HTTPS is set
# explicitly.
ENVIRONMENT=development

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# Key rotation: comma-separated *previous* JWT_SECRET_KEY values, still accepted to verify
# tokens issued before a rotation. Leave empty outside of an active rotation. To rotate: move
# the current JWT_SECRET_KEY here (front of the list), generate a new JWT_SECRET_KEY, deploy;
# drop the old value once JWT_REFRESH_TOKEN_EXPIRE_DAYS has passed since the rotation.
JWT_PREVIOUS_SECRET_KEYS=

# --- Field-level encryption at rest ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key
# Key rotation: comma-separated *previous* FIELD_ENCRYPTION_KEY values, still accepted to
# decrypt columns encrypted under them (see services/encryption.py — backed by
# cryptography.fernet.MultiFernet). Leave empty outside of an active rotation. To rotate: move
# the current FIELD_ENCRYPTION_KEY here (front of the list), generate a new
# FIELD_ENCRYPTION_KEY, deploy; only drop an old key once every row it encrypted has been
# re-saved under the new key (dropping it earlier makes those rows unreadable).
FIELD_ENCRYPTION_KEY_PREVIOUS=

# --- SSO / enterprise identity (optional — leave SSO_ENABLED=false for local/course use) ---
SSO_ENABLED=false
SSO_PROVIDER=azure-ad
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_REDIRECT_URI=http://localhost:5173/auth/sso/callback

# --- Transport security ---
# Set true only behind a TLS-terminating reverse proxy; local `uvicorn --reload` has no cert.
# Auto-set to true when ENVIRONMENT=production unless set explicitly here — see config.py.
FORCE_HTTPS=false
