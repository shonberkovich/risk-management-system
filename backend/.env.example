ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Field-level encryption at rest ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never rotate without re-encrypting existing ciphertext columns first.
FIELD_ENCRYPTION_KEY=change-me-to-a-generated-fernet-key

# --- SSO / enterprise identity (optional — leave SSO_ENABLED=false for local/course use) ---
SSO_ENABLED=false
SSO_PROVIDER=azure-ad
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_REDIRECT_URI=http://localhost:5173/auth/sso/callback

# --- Transport security ---
# Set true only behind a TLS-terminating reverse proxy; local `uvicorn --reload` has no cert.
FORCE_HTTPS=false
